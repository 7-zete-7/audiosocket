{
    "name": "7-zete-7/audiosocket",
    "type": "library",
    "description": "Implementation of Asterisk AudioSocket protocol.",
    "keywords": [
        "Asterisk AudioSocket",
        "AudioSocket"
    ],
    "homepage": "https://github.com/7-zete-7/audiosocket",
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        {
            "name": "Stanislau Kviatkouski",
            "email": "7zete7@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/uid": "^8.1.0 || ^7.4.0 || ^6.4.0"
    },
    "autoload": {
        "psr-4": {
            "Zete7\\AudioSocket\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zete7\\AudioSocket\\Test\\": "tests/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    }
}
